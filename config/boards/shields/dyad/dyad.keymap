#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    tapping-term-ms = <250>;
    flavor = "tap-preferred";
};

/ {
    combos {
        compatible = "zmk,combos";

        delete_combo2 {
            bindings = <&kp DELETE>;
            key-positions = <9 19>;
            layers = <0>;
        };

        minus_combo {
            bindings = <&kp MINUS>;
            key-positions = <32 33>;
            layers = <1>;
        };

        undo_combo {
            bindings = <&kp LC(Z)>;
            key-positions = <20 21>;
            layers = <0 1>;
        };

        BackspaceWord_combo {
            bindings = <&lt 7 LC(BACKSPACE)>;
            key-positions = <30 31>;
            layers = <0>;
        };

        delete_comb {
            bindings = <&lt 9 DELETE>;
            key-positions = <33 32>;
            layers = <0>;
        };

        F5_combo {
            bindings = <&kp F5>;
            key-positions = <17 7>;
            layers = <0>;
        };

        prtscn_combo {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <15 5>;
            layers = <0>;
        };

        underscore_combo {
            bindings = <&kp UNDERSCORE>;
            key-positions = <32 33>;
            layers = <2>;
        };

        pin_combo {
            bindings = <&pin_macro>;
            key-positions = <30 33 31 32>;
        };

        Caps {
            bindings = <&kp CAPS>;
            key-positions = <1 2>;
            layers = <0>;
        };

        Delete {
            bindings = <&kp DELETE>;
            key-positions = <4 3>;
            layers = <0>;
        };

        NewWindow_macro {
            bindings = <&NewWindow_macro>;
            key-positions = <14 2>;
            layers = <0>;
        };

        Search {
            bindings = <&kp LC(E)>;
            key-positions = <3 2>;
            layers = <0>;
        };

        SwitchTabs {
            bindings = <&kp LA(TAB)>;
            key-positions = <24 23>;
            layers = <0>;
        };

        Paint {
            bindings = <&paint_macro>;
            key-positions = <5 6>;
            layers = <0>;
        };

        InternalTabs {
            bindings = <&kp LC(TAB)>;
            key-positions = <24 22>;
            layers = <0>;
        };

        CTRL_S {
            bindings = <&kp LC(S)>;
            key-positions = <0 1>;
            layers = <0>;
        };

        REDO {
            bindings = <&kp LC(Y)>;
            key-positions = <10 11>;
            layers = <0 1>;
        };

        CloseInternal {
            bindings = <&kp LC(F4)>;
            key-positions = <24 25>;
        };

        CloseWindow {
            bindings = <&kp LA(F4)>;
            key-positions = <14 15>;
        };

        Windows {
            bindings = <&kp LEFT_WIN>;
            key-positions = <29 19>;
        };

        Alt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <20 10>;
        };

        CtrlAltDel {
            bindings = <&CtrlAltDel>;
            key-positions = <0 20 10>;
        };

        insert {
            bindings = <&kp INSERT>;
            key-positions = <9 8>;
        };

        TabEnter {
            bindings = <&ACADE_TabEnter>;
            key-positions = <13 12>;
            layers = <1>;
        };
    };

    macros {
        pin_macro: pin_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(M) &kp I &kp S &kp S &kp LS(D) &kp A &kp I &kp S &kp Y &kp MINUS &kp N1 &kp N2 &kp N3 &kp NUMBER_4 &kp N5>;
            label = "PIN_MACRO";
            wait-ms = <25>;
            tap-ms = <25>;
        };

        NewWindow_macro: NewWindow_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_tap>,
                <&kp E>,
                <&macro_release>,
                <&kp LEFT_WIN>;

            label = "NEWWINDOW_MACRO";
            wait-ms = <50>;
            tap-ms = <50>;
        };

        Switch_macro: Switch_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kt LEFT_WIN>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LEFT_WIN>;

            label = "SWITCH_MACRO";
            wait-ms = <25>;
            tap-ms = <25>;
        };

        paint_macro: paint_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_tap>,
                <&kp NUMBER_1>,
                <&macro_release>,
                <&kp LEFT_WIN>;

            label = "PAINT_MACRO";
            wait-ms = <50>;
            tap-ms = <50>;
        };

        Brackets_macro: Brackets_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;
            label = "BRACKETS_MACRO";
            wait-ms = <50>;
            tap-ms = <50>;
        };

        CB_History_macro: CB_History_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_tap>,
                <&kp V>,
                <&macro_release>,
                <&kp LEFT_WIN>;

            label = "CB_History_macro";
            wait-ms = <1>;
            tap-ms = <1>;
        };

        MoveRight_macro: MoveRight_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp LEFT_WIN &kp LEFT_SHIFT>;

            label = "MOVERIGHT_MACRO";
            wait-ms = <1>;
            tap-ms = <1>;
        };

        SelectLine_macro: SelectLine_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END)>;
            label = "SELECTLINE_MACRO";
        };

        MoveLeft_macro: MoveLeft_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp LEFT_WIN &kp LEFT_SHIFT>;

            label = "MOVELEFT_MACRO";
            wait-ms = <1>;
            tap-ms = <1>;
        };

        TextExtractor_macro: TextExtractor_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp T>,
                <&macro_release>,
                <&kp LEFT_WIN &kp LEFT_SHIFT>;

            label = "TEXTEXTRACTOR_MACRO";
            wait-ms = <1>;
            tap-ms = <1>;
        };

        ACADE_SaveZoomClose: SaveZoomClose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp V &kp RET>;
            label = "SAVEZOOMCLOSE";
        };

        ACADE_CloseNoSave: ACADE_close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp C &kp RET>;
            label = "ACADE_CLOSE";
        };

        ACADE_edit: ACADE_edit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E &kp D &kp I &kp T &kp RET>;
            label = "ACADE_EDIT";
        };

        ACADE_Align: ACADE_Align {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp E &kp A &kp RET>;
            label = "ACADE_ALIGN";
        };

        ACADE_SaveNext: ACADE_SaveNext {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp N &kp RET>;
            label = "ACADE_SAVENEXT";
        };

        ACADE_SavePrevious: ACADE_SavePrevious {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp B &kp RET>;
            label = "ACADE_SAVEPREVIOUS";
        };

        ACADE_Wire: ACADE_Wire {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp E &kp W &kp RET>;
            label = "ACADE_WIRE";
        };

        ACADE_FlipWireNo: ACADE_FlipWireNo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp E &kp F &kp L &kp W &kp RET>;
            label = "ACADE_FLIPWIRENO";
        };

        ACADE_Justify: ACADE_Justify {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp E &kp J &kp RET>;
            label = "ACADE_JUSTIFY";
        };

        ACADE_Surf: ACADE_Surf {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp E &kp S &kp RET>;
            label = "ACADE_SURF";
        };

        Taskbar_2: Taskbar_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_tap>,
                <&kp NUMBER_2>,
                <&macro_release>,
                <&kp LEFT_WIN>;

            label = "TASKBAR_1";
            wait-ms = <50>;
            tap-ms = <50>;
        };

        Taskbar_3: Taskbar_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_tap>,
                <&kp NUMBER_3>,
                <&macro_release>,
                <&kp LEFT_WIN>;

            label = "TASKBAR_3";
            wait-ms = <50>;
            tap-ms = <50>;
        };

        Taskbar_4: Taskbar_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_tap>,
                <&kp NUMBER_4>,
                <&macro_release>,
                <&kp LEFT_WIN>;

            label = "TASKBAR_4";
            wait-ms = <50>;
            tap-ms = <50>;
        };

        Taskbar_5: Taskbar_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_tap>,
                <&kp N5>,
                <&macro_release>,
                <&kp LEFT_WIN>;

            label = "TASKBAR_5";
            wait-ms = <50>;
            tap-ms = <50>;
        };

        CtrlAltDel: CtrlAltDel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_press>,
                <&kp DELETE>,
                <&macro_release>,
                <&kp LEFT_CONTROL>,
                <&macro_release>,
                <&kp LEFT_ALT>,
                <&macro_release>,
                <&kp DELETE>;

            label = "CTRLALTDEL";
        };

        Taskbar_6: Taskbar_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_tap>,
                <&kp NUMBER_6>,
                <&macro_release>,
                <&kp LEFT_WIN>;

            label = "TASKBAR_6";
            wait-ms = <50>;
            tap-ms = <50>;
        };

        Taskbar_7: Taskbar_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_tap>,
                <&kp N7>,
                <&macro_release>,
                <&kp LEFT_WIN>;

            label = "TASKBAR_7";
            wait-ms = <50>;
            tap-ms = <50>;
        };

        Taskbar_8: Taskbar_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_tap>,
                <&kp N8>,
                <&macro_release>,
                <&kp LEFT_WIN>;

            label = "TASKBAR_8";
            wait-ms = <50>;
            tap-ms = <50>;
        };

        Taskbar_9: Taskbar_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_tap>,
                <&kp NUMBER_9>,
                <&macro_release>,
                <&kp LEFT_WIN>;

            label = "TASKBAR_9";
            wait-ms = <50>;
            tap-ms = <50>;
        };

        Taskbar_10: Taskbar_10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_tap>,
                <&kp NUMBER_0>,
                <&macro_release>,
                <&kp LEFT_WIN>;

            label = "TASKBAR_10";
            wait-ms = <50>;
            tap-ms = <50>;
        };

        ACADE_TabEnter: ACADE_TabEnter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp TAB>,
                <&macro_wait_time 50>,
                <&kp ENTER>;

            label = "ACADE_TABENTER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&mt TAB Q    &kp W  &kp E  &kp R      &kp T        &kp Y      &kp U              &kp I                &kp O            &kp P
&mt LSHFT A  &kp S  &kp D  &kp F      &kp G        &kp H      &mt RIGHT_SHIFT J  &mt RIGHT_CONTROL K  &mt RIGHT_ALT L  &kp APOS
&mt LCTRL Z  &kp X  &kp C  &kp V      &lt 8 B      &kp N      &kp M              &kp COMMA            &kp PERIOD       &kp SLASH
                           &lt 2 ESC  &lt 1 ENTER  &kp SPACE  &lt 3 BACKSPACE
            >;
        };

        num_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp PAGE_UP    &kp HOME        &kp UP_ARROW     &kp END            &kp TAB          &kp LEFT_BRACKET  &kp N7        &kp N8        &kp N9        &kp RIGHT_BRACKET
&kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW   &kp RIGHT_ARROW    &mt LC(V) LC(X)  &kp EQUAL         &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp SEMICOLON
&kp LEFT_ALT   &caps_word      &Brackets_macro  &CB_History_macro  &mt LC(V) LC(C)  &kp BACKSLASH     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp GRAVE
                                                &trans             &trans           &kp N0            &kp PERIOD
            >;
        };

        symbol_layer {
            bindings = <
&trans                &trans        &kp LC(W)          &kp LC(E)         &kp LC(F4)  &kp LEFT_BRACE        &kp AMPERSAND          &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_BRACE
&TextExtractor_macro  &trans        &MoveLeft_macro    &MoveRight_macro  &trans      &kp PLUS              &kp DOLLAR             &kp PERCENT   &kp CARET             &kp COLON
&trans                &kp LS(HOME)  &SelectLine_macro  &kp LS(END)       &trans      &kp PIPE              &kp EXCLAMATION        &kp AT_SIGN   &kp HASH              &kp TILDE
                                                       &trans            &trans      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
            >;
        };

        function_layer {
            bindings = <
&bt BT_PRV      &trans  &bootloader  &trans  &bt BT_NXT  &kp PRINTSCREEN  &kp F7  &kp F8  &kp F9  &kp F12
&trans          &trans  &soft_off    &trans  &trans      &kp SCROLLLOCK   &kp F4  &kp F5  &kp F6  &kp F11
&bt BT_CLR_ALL  &trans  &trans       &trans  &trans      &kp PAUSE_BREAK  &kp F1  &kp F2  &kp F3  &kp F10
                                     &trans  &trans      &trans           &trans
            >;
        };

        mouse_layer {
            bindings = <
&msc SCRL_UP    &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &trans      &trans  &trans     &trans     &trans     &trans
&msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans      &trans  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans
&kp K_UNDO      &kp K_CUT       &kp K_COPY      &kp K_PASTE      &kp K_REDO  &trans  &trans     &trans     &trans     &trans
                                                &mkp LCLK        &mkp RCLK   &trans  &trans
            >;
        };

        navigation_layer {
            bindings = <
&kp PAGE_UP    &kp HOME        &kp UP_ARROW    &kp END      &kp INSERT    &trans  &trans  &trans  &trans  &trans
&kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT    &kp CAPSLOCK  &trans  &trans  &trans  &trans  &trans
&kp K_UNDO     &kp K_CUT       &kp K_COPY      &kp K_PASTE  &kp K_REDO    &trans  &trans  &trans  &trans  &trans
                                               &trans       &trans        &trans  &trans
            >;
        };

        media_layer {
            bindings = <
&trans  &kp K_PREVIOUS  &kp C_VOLUME_UP    &kp K_NEXT          &trans            &trans  &trans  &trans  &trans  &trans
&trans  &kp C_REWIND    &kp C_VOLUME_DOWN  &kp C_FAST_FORWARD  &trans            &trans  &trans  &trans  &trans  &trans
&trans  &trans          &kp K_MUTE         &trans              &trans            &trans  &trans  &trans  &trans  &trans
                                           &kp K_MUTE          &kp K_PLAY_PAUSE  &trans  &trans
            >;
        };

        ACADE {
            bindings = <
&trans  &kp LC(W)       &kp LC(E)          &ACADE_SavePrevious   &ACADE_SaveNext     &trans  &trans  &trans  &trans  &trans
&trans  &ACADE_Justify  &ACADE_edit        &ACADE_SaveZoomClose  &ACADE_CloseNoSave  &trans  &trans  &trans  &trans  &trans
&trans  &ACADE_Surf     &ACADE_FlipWireNo  &ACADE_Align          &ACADE_Wire         &trans  &trans  &trans  &trans  &trans
                                           &trans                &trans              &trans  &trans
            >;
        };

        Studio5000 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans
            >;
        };

        Taskbar_Hotkeys {
            bindings = <
&trans        &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
&paint_macro  &Taskbar_2  &Taskbar_3  &Taskbar_4  &Taskbar_5  &Taskbar_6  &Taskbar_7  &Taskbar_8  &Taskbar_9  &Taskbar_10
&trans        &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
                                      &trans      &trans      &trans      &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Test {
            if-layers = <1>;
            then-layer = <2>;
        };
    };
};
